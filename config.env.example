# Copy this file to "config.env" (same folder as app.py) and fill in what you need.
# Lines starting with # are ignored. Restart the server after a change.

# ---- Database (Neon) ---------------------------------------------------------
# Connection string from the Neon console (Connect button). When empty, the data is kept in the
# local SQLite file road_speed.db. To bring that data into Neon: python import_sqlite.py
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Email (needed so drivers receive their code) -------------------------
# Gmail: turn on 2-step verification, then create an "App password" at
# myaccount.google.com/apppasswords and paste it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-letter-app-password
SMTP_FROM=your.address@gmail.com

# If your host or network blocks email ports (587/465), use Brevo instead (free plan,
# sends over HTTPS). When BREVO_API_KEY is set it is used instead of SMTP.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=your.address@gmail.com     # a sender verified in your Brevo account

# Check the email settings:   python send_driver_code.py --test

# ---- Sign-in link in account emails -----------------------------------------
# Public address of the app, used for the sign-in link in emails. Set it when deployed,
# e.g. https://<account>.alwaysdata.net. When empty, the link uses the address the admin
# has open; "python app.py --lan" uses this computer's Wi-Fi address automatically.
# APP_URL=https://<account>.alwaysdata.net

# ---- MQTT (optional: link to roadside stations / vehicle units) -----------
# MQTT_HOST=broker.hivemq.com
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# MQTT_TLS=0

# ---- Other -----------------------------------------------------------------
# PORT=5000
# SEED_SAMPLE_DRIVERS=1        # create 3 sample drivers on first run (testing only)
# RSR_FORCE_HTTPS=1            # when deployed behind an HTTPS reverse proxy
